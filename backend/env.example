# Server Configuration
PORT=3001
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/echoprompt

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Hosted AI (required for free tier without user keys)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
HOSTED_AI_LIMIT_GUEST=10
HOSTED_AI_LIMIT_AUTH=30

# App URLs
FRONTEND_URL=http://localhost:5173

# Admin (comma-separated emails allowed to access /analytics)
ADMIN_EMAILS=you@example.com

# Free SMTP (e.g. Brevo/Sendinblue 300/day, Gmail app password, Mailtrap for dev)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-login
SMTP_PASS=your-smtp-password
# Use an address verified in Brevo → Senders (e.g. your Gmail)
SMTP_FROM=EchoPrompt <you@example.com>

# CORS (comma-separated origins for production)
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=12
